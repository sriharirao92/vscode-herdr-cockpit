{
  "name": "herdr-hub",
  "displayName": "Herdr Hub",
  "description": "Community client for Herdr: your Herdr spaces, agents and shells in one VS Code window. Switch spaces, open agents as terminal tabs, review their changes. Works in VS Code, Cursor, Kiro and Positron.",
  "version": "0.0.30",
  "publisher": "sriharirao",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#121826",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sriharirao92/herdr-hub.git"
  },
  "homepage": "https://github.com/sriharirao92/herdr-hub#readme",
  "bugs": {
    "url": "https://github.com/sriharirao92/herdr-hub/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "herdr",
    "agents",
    "ai",
    "terminal",
    "multiplexer",
    "claude code",
    "codex",
    "kiro",
    "worktree"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "herdr",
          "title": "Herdr Hub",
          "icon": "media/herdr.svg"
        }
      ]
    },
    "views": {
      "herdr": [
        {
          "type": "webview",
          "id": "herdr.spaces",
          "name": "Spaces & Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "herdr.refresh",
        "title": "Refresh",
        "category": "Herdr Hub",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.switchSpace",
        "title": "Switch to Space",
        "category": "Herdr Hub",
        "icon": "$(arrow-right)"
      },
      {
        "command": "herdr.pinSpace",
        "title": "Mount Space Alongside (Pin)",
        "category": "Herdr Hub",
        "icon": "$(pin)"
      },
      {
        "command": "herdr.unmountSpace",
        "title": "Unmount Space",
        "category": "Herdr Hub",
        "icon": "$(close)"
      },
      {
        "command": "herdr.attach",
        "title": "Attach Terminal",
        "category": "Herdr Hub",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.reviewChanges",
        "title": "Review Agent Changes",
        "category": "Herdr Hub",
        "icon": "$(diff)"
      },
      {
        "command": "herdr.focusAttention",
        "title": "Jump to Agent Needing Attention",
        "category": "Herdr Hub"
      },
      {
        "command": "herdr.openTui",
        "title": "Open Herdr TUI",
        "category": "Herdr Hub",
        "icon": "$(window)"
      },
      {
        "command": "herdr.setupHub",
        "title": "Set Up Hub Window",
        "category": "Herdr Hub"
      },
      {
        "command": "herdr.toggleFollow",
        "title": "Follow Herdr Focus",
        "category": "Herdr Hub",
        "toggled": "config.herdr.followMode"
      },
      {
        "command": "herdr.dumpSnapshot",
        "title": "Show Raw Session Snapshot",
        "category": "Herdr Hub"
      },
      {
        "command": "herdr.toggleShellPanes",
        "title": "Toggle Shell Panes",
        "category": "Herdr Hub",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.openSettings",
        "title": "Settings",
        "category": "Herdr Hub",
        "icon": "$(settings-gear)"
      },
      {
        "command": "herdr.showRaw",
        "title": "Show Raw Herdr Record",
        "category": "Herdr Hub",
        "icon": "$(json)"
      },
      {
        "command": "herdr.openHelp",
        "title": "How to Read the Sidebar",
        "category": "Herdr Hub",
        "icon": "$(question)"
      },
      {
        "command": "herdr.newTab",
        "title": "New Tab…",
        "category": "Herdr Hub",
        "icon": "$(add)"
      },
      {
        "command": "herdr.rename",
        "title": "Rename…",
        "category": "Herdr Hub"
      },
      {
        "command": "herdr.closeInHerdr",
        "title": "Close in Herdr…",
        "category": "Herdr Hub"
      },
      {
        "command": "herdr.newSpace",
        "title": "New Space…",
        "category": "Herdr Hub",
        "icon": "$(add)"
      },
      {
        "command": "herdr.setupClaudeUsage",
        "title": "Show Claude Plan Limits in the Sidebar…",
        "category": "Herdr Hub"
      },
      {
        "command": "herdr.setKiroCredits",
        "title": "Set Kiro Monthly Credits…",
        "category": "Herdr Hub"
      },
      {
        "command": "herdr.startServer",
        "title": "Start Herdr",
        "category": "Herdr Hub",
        "icon": "$(play)"
      },
      {
        "command": "herdr.copyDiagnostics",
        "title": "Copy Diagnostics",
        "category": "Herdr Hub"
      },
      {
        "command": "herdr.connectionMenu",
        "title": "Connection Options",
        "category": "Herdr Hub"
      },
      {
        "command": "herdr.openInstallDocs",
        "title": "Install Herdr",
        "category": "Herdr Hub"
      },
      {
        "command": "herdr.installPlugin",
        "title": "Install the Herdr Plugin",
        "category": "Herdr Hub"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "herdr.openHelp",
          "when": "view == herdr.spaces",
          "group": "navigation@1"
        },
        {
          "command": "herdr.startServer",
          "when": "view == herdr.spaces && !herdr.connected",
          "group": "0_start@1"
        },
        {
          "command": "herdr.toggleFollow",
          "when": "view == herdr.spaces",
          "group": "1_follow@1"
        },
        {
          "command": "herdr.openTui",
          "when": "view == herdr.spaces",
          "group": "2_open@1"
        },
        {
          "command": "herdr.setupHub",
          "when": "view == herdr.spaces",
          "group": "2_open@2"
        },
        {
          "command": "herdr.refresh",
          "when": "view == herdr.spaces",
          "group": "3_tools@1"
        },
        {
          "command": "herdr.openSettings",
          "when": "view == herdr.spaces",
          "group": "3_tools@2"
        },
        {
          "command": "herdr.dumpSnapshot",
          "when": "view == herdr.spaces",
          "group": "3_tools@3"
        }
      ],
      "commandPalette": [
        {
          "command": "herdr.pinSpace",
          "when": "false"
        },
        {
          "command": "herdr.unmountSpace",
          "when": "false"
        },
        {
          "command": "herdr.attach",
          "when": "false"
        },
        {
          "command": "herdr.showRaw",
          "when": "false"
        },
        {
          "command": "herdr.rename",
          "when": "false"
        },
        {
          "command": "herdr.closeInHerdr",
          "when": "false"
        },
        {
          "command": "herdr.connectionMenu",
          "when": "false"
        },
        {
          "command": "herdr.openInstallDocs",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "herdr.switchSpace",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^space/",
          "group": "1_space@1"
        },
        {
          "command": "herdr.pinSpace",
          "when": "webviewId == herdr.spaces && webviewSection == space",
          "group": "1_space@2"
        },
        {
          "command": "herdr.unmountSpace",
          "when": "webviewId == herdr.spaces && webviewSection == space-mounted",
          "group": "1_space@2"
        },
        {
          "command": "herdr.attach",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^(agent|shell)$/",
          "group": "1_pane@1"
        },
        {
          "command": "herdr.reviewChanges",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^(space|space-mounted|agent)$/",
          "group": "2_review@1"
        },
        {
          "command": "herdr.showRaw",
          "when": "webviewId == herdr.spaces && webviewSection",
          "group": "9_debug@1"
        },
        {
          "command": "herdr.newTab",
          "when": "webviewId == herdr.spaces && webviewSection =~ /^space/",
          "group": "0_create@1"
        },
        {
          "command": "herdr.rename",
          "when": "webviewId == herdr.spaces && webviewSection",
          "group": "7_edit@1"
        },
        {
          "command": "herdr.closeInHerdr",
          "when": "webviewId == herdr.spaces && webviewSection",
          "group": "8_close@1"
        }
      ]
    },
    "configuration": {
      "title": "Herdr Hub",
      "properties": {
        "herdr.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the herdr binary. Empty = auto-detect (Homebrew, ~/.local/bin, PATH). Machine setting: ignored in workspace and folder settings, so a repository can't choose the program the extension runs.",
          "scope": "machine"
        },
        "herdr.socketPath": {
          "type": "string",
          "default": "",
          "description": "Herdr socket path. Empty = HERDR_SOCKET_PATH, then ~/.config/herdr/herdr.sock. Machine setting: ignored in workspace and folder settings.",
          "scope": "machine"
        },
        "herdr.startServer": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Ask once when the hub window opens and Herdr isn't running, then remember the answer.",
            "Start Herdr in the background whenever the hub window opens and it isn't running.",
            "Never start Herdr automatically (the sidebar still offers a Start Herdr button)."
          ],
          "description": "Whether the Herdr Hub window starts the Herdr server (in the background) when it isn't running."
        },
        "herdr.followMode": {
          "type": "boolean",
          "default": true,
          "description": "When you switch spaces in Herdr (e.g. in your Mac terminal), this window follows. Only active in a hub window or after you've switched a space from VS Code."
        },
        "herdr.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "editorSplit",
            "panel"
          ],
          "default": "editor",
          "enumDescriptions": [
            "Editor area, as tabs in the active group.",
            "Editor area, agents in the left group and shells in the right one.",
            "The terminal panel."
          ],
          "description": "Where attached agent and shell terminals open."
        },
        "herdr.closeTerminalsOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Close attach terminals of other spaces when switching. Agents keep running in Herdr."
        },
        "herdr.autoAttachOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "When switching to a space, open each of its panes as its own terminal tab: agents first (most urgent first), then shells (see herdr.autoAttachShells)."
        },
        "herdr.autoAttachShells": {
          "type": "boolean",
          "default": true,
          "description": "Also open the space's plain shell panes when switching to it (needs herdr.autoAttachOnSwitch)."
        },
        "herdr.notifyOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "blocked",
              "done",
              "working",
              "idle"
            ]
          },
          "default": [
            "blocked",
            "done"
          ],
          "description": "Agent states that trigger a VS Code notification."
        },
        "herdr.agents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claude",
            "codex",
            "kiro",
            "cursor"
          ],
          "description": "Agents offered first when creating a tab or space (Herdr agent kinds, e.g. claude, codex, kiro, cursor, gemini, copilot, opencode, amp). The rest are under \"More agents…\"."
        },
        "herdr.kiroMonthlyCredits": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Your Kiro plan's monthly credit allowance (Kiro shows it in /usage). Kiro doesn't expose it to other tools, so enter it here to see a usage bar in the sidebar. 0 = unknown."
        },
        "herdr.showShellPanes": {
          "type": "boolean",
          "default": true,
          "description": "Show plain shell panes under each space (Herdr's own agent list hides them)."
        },
        "herdr.hubWindow": {
          "type": "boolean",
          "default": false,
          "description": "Marks this window as the Herdr hub (set automatically by 'Set up Herdr Hub Window')."
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "herdr.shell",
          "title": "Herdr Shell",
          "icon": "terminal"
        },
        {
          "id": "herdr.agent.claude",
          "title": "Herdr: Claude",
          "icon": {
            "light": "media/agent-logos/claude-color.svg",
            "dark": "media/agent-logos/claude-color.svg"
          }
        },
        {
          "id": "herdr.agent.codex",
          "title": "Herdr: Codex",
          "icon": {
            "light": "media/agent-logos/codex-color.svg",
            "dark": "media/agent-logos/codex-color.svg"
          }
        },
        {
          "id": "herdr.agent.kiro",
          "title": "Herdr: Kiro",
          "icon": {
            "light": "media/agent-logos/kiro-color.svg",
            "dark": "media/agent-logos/kiro-color.svg"
          }
        },
        {
          "id": "herdr.agent.cursor",
          "title": "Herdr: Cursor",
          "icon": {
            "light": "media/agent-logos/cursor-light.svg",
            "dark": "media/agent-logos/cursor-dark.svg"
          }
        },
        {
          "id": "herdr.agent.other",
          "title": "Herdr: Other Agent…",
          "icon": "hubot"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with Herdr Hub",
        "description": "Bring your Herdr spaces, agents and shells into this window.",
        "steps": [
          {
            "id": "start",
            "title": "Connect to Herdr",
            "description": "The sidebar connects to your running Herdr server.\n[Start Herdr](command:herdr.startServer)",
            "media": {
              "markdown": "media/walkthrough/start.md"
            },
            "completionEvents": [
              "onContext:herdr.connected"
            ]
          },
          {
            "id": "hub",
            "title": "Open the hub window",
            "description": "A dedicated window whose first folder never changes, so switching spaces never restarts extensions.\n[Set Up Hub Window](command:herdr.setupHub)",
            "media": {
              "markdown": "media/walkthrough/hub.md"
            },
            "completionEvents": [
              "onCommand:herdr.setupHub"
            ]
          },
          {
            "id": "sidebar",
            "title": "Find the sidebar",
            "description": "Spaces, agents and shells, live from Herdr.\n[Show the Sidebar](command:herdr.spaces.focus)",
            "media": {
              "markdown": "media/walkthrough/sidebar.md"
            },
            "completionEvents": [
              "onView:herdr.spaces"
            ]
          },
          {
            "id": "plugin",
            "title": "Install the Herdr plugin",
            "description": "Jump from Herdr in your terminal to this editor, and open files from any pane.\n[Install Plugin](command:herdr.installPlugin)",
            "media": {
              "markdown": "media/walkthrough/plugin.md"
            },
            "completionEvents": [
              "onCommand:herdr.installPlugin"
            ]
          },
          {
            "id": "usage",
            "title": "See your plan limits",
            "description": "Claude Code, Codex and Kiro usage in the sidebar.\n[Show Plan Limits](command:herdr.setupClaudeUsage)",
            "media": {
              "markdown": "media/walkthrough/usage.md"
            },
            "completionEvents": [
              "onCommand:herdr.setupClaudeUsage"
            ]
          },
          {
            "id": "guide",
            "title": "Read the guide",
            "description": "What every color, icon and button means.\n[Open the Guide](command:herdr.openHelp)",
            "media": {
              "markdown": "media/walkthrough/guide.md"
            },
            "completionEvents": [
              "onCommand:herdr.openHelp"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "gen:types": "node scripts/gen-herdr-types.mjs",
    "gen:icons": "node scripts/gen-agent-icons.mjs",
    "codicons": "node scripts/copy-codicons.mjs",
    "pretest": "tsc -p .",
    "test": "node out/test/mockTest.js && node out/test/viewTest.js && node out/test/usageTest.js && node out/test/connectionTest.js && node out/test/hubTest.js && node out/test/pluginTest.js && node out/test/gitTest.js",
    "package": "npm run codicons && tsc -p . && vsce package",
    "install-local": "npm run package && code --install-extension herdr-hub-$npm_package_version.vsix --force",
    "lint": "eslint --no-warn-ignored src media/*.js scripts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.39.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted windows the sidebar doesn't run git, and workspace settings can't mark the window as the Herdr hub.",
      "restrictedConfigurations": [
        "herdr.hubWindow"
      ]
    }
  },
  "extensionKind": [
    "workspace"
  ]
}
